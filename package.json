{
  "name": "flipid",
  "version": "1.0.0",
  "author": "misebox",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tsconfig-to-dual-package": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/misebox/flipid/issues"
  },
  "description": "Simple and Reversible ID Transformation",
  "keywords": [
    "id",
    "obfuscation",
    "encode",
    "decode",
    "reversible",
    "transform",
    "hashid",
    "shortid",
    "url-safe",
    "base32",
    "base58",
    "base64",
    "bufferbase"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/misebox/flipid#readme",
  "license": "ISC",
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && tsconfig-to-dual-package",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepublishOnly": "bun run build",
    "release": "./bin/release",
    "test": "vitest --coverage",
    "test:watch": "vitest watch",
    "lint": "oxlint src/",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "tsx": "tsx"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "bufferbase": "^3.1.0"
  }
}
