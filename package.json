{
  "name": "flipid",
  "version": "0.4.2",
  "author": "misebox",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.1",
    "semantic-release": "^25.0.2",
    "tsconfig-to-dual-package": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/misebox/flipid/issues"
  },
  "description": "Simple and Reversible ID Transformation",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/misebox/flipid#readme",
  "license": "ISC",
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && tsconfig-to-dual-package",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepublishOnly": "bun run build",
    "release": "semantic-release",
    "example": "bun run ./src/example.ts",
    "test": "vitest --coverage",
    "test:watch": "vitest watch",
    "tsx": "tsx"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "bufferbase": "^2.0.0"
  }
}
